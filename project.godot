; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Not Windforge"
config/version="0.50.0"
run/main_scene="res://maps/world/world.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

Net="*res://net/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

; Desktop keeps Forward+ (Vulkan); the WEB export MUST fall back to the
; Compatibility renderer (WebGL2) - browsers cannot run Forward+/Vulkan. The
; game is plain 2D drawing, so Compatibility renders it identically. This
; per-platform override is what makes the GitHub Pages web build work at all.
; (";" comments, never "#": Godot's config parser garbles "#" lines into
; broken keys the next time it re-saves this file - it bit us 2026-08-24.)
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"

